    </asset>

    <worldbody>
        <body name="floor">
            <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="1"
                priority="1" friction="0.6" condim="3"/>
        </body>
    </worldbody>
    <keyframe>
        <!-- Re-derived via thing_test/search_home_pose_v4.py: searched
             palm_z + per-joint finger curl (respecting actual joint
             ranges) for a pose that survives the full 1000-step episode
             length under plain PD hold with no policy/RL involved at all
             (flipped=False, palm_drift=0.0015, contact_frac=0.947,
             max_qacc=2964 -- all dramatically better than the original
             qpos, which free-fell 24-28cm before any contact and exploded
             on impact). This fixes the home pose at the geometry level
             instead of relying on RL to recover from a physically
             unrealistic start. -->
        <key name="home" qpos="0.0165 0.0052 0.12 0.9999 0.0052 -0.0147 -0.0004 0.3220 -0.3350 1.2684 0.0000 0.3220 -0.0000 1.2813 -0.0379 0.2075 0.5235 1.3625 0.0175 1.8131 -0.3490 -0.4700 0.0000"/>
    </keyframe>
