<!-- CPG カメラプリセット集 -->
<!-- 真横から見る様々な角度を定義 -->

<!-- サイドビュー1: 少し低い位置から -->
<camera name="side1" pos="0.5 0.5 0.12" xyaxes="0 1 0 0 0 1"/>

<!-- サイドビュー2: 標準的な高さ -->
<camera name="side2" pos="0.5 0.5 0.15" xyaxes="0 1 0 0 0 1"/>

<!-- サイドビュー3: 少し高い位置から -->
<camera name="side3" pos="0.5 0.5 0.20" xyaxes="0 1 0 0 0 1"/>

<!-- サイドビュー4: さらにズームアウト -->
<camera name="side4" pos="0.6 0.6 0.15" xyaxes="0 1 0 0 0 1"/>
